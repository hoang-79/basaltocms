{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "basalto/basalto",
    "type": "project",
    "description": "Basalto — a Laravel CMS for agencies and SMEs: themes in one file, editing without a plugin puzzle, backend and frontend from one hand. Source-available, free for one site.",
    "keywords": [
        "laravel-cms",
        "laravel",
        "cms",
        "inertiajs",
        "vue"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "basalto/core": "@dev",
        "basalto/lava": "@dev",
        "basalto/module-ai": "@dev",
        "basalto/module-comments": "@dev",
        "basalto/module-forum": "@dev",
        "basalto/module-members": "@dev",
        "dompdf/dompdf": "^3.1",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/ai": "^1.2",
        "laravel/cashier": "^16.9",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/pulse": "^1.8",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.9",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "league/flysystem-aws-s3-v3": "^3.0",
        "socialiteproviders/microsoft": "^4.10",
        "sprain/swiss-qr-bill": "^5.3"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/cloud-cli": "^0.6.5",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "phpunit/phpunit": "^12.5.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "vendor/laravel/cloud-cli/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build",
            "npm run build:backend",
            "@php artisan vendor:publish --tag=basalto-assets --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run check",
            "npm run types:check",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "npm install",
            "npm run build",
            "npm run build:backend",
            "@php artisan vendor:publish --tag=basalto-assets --force --ansi",
            "@php -r \"echo PHP_EOL, 'Weiter mit «php artisan basalto:install»: erste Site, erstes Konto und Einmal-Link zur Anmeldung.', PHP_EOL;\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "modules/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "homepage": "https://basaltocms.com",
    "support": {
        "issues": "https://github.com/hoang-79/basaltocms/issues",
        "forum": "https://basaltocms.com/community",
        "source": "https://github.com/hoang-79/basaltocms"
    }
}
