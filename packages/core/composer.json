{
    "name": "basalto/core",
    "description": "Basalto-Kern: Backend (Inertia/Vue, fertig gebaut im Paket), Sites, Erweiterungs-System.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/view": "^13.0",
        "inertiajs/inertia-laravel": "^3.0",
        "basalto/lava": "*",
        "laravel/scout": "^11.9",
        "laravel/sanctum": "^4.3",
        "laravel/cashier": "^16.9",
        "dompdf/dompdf": "^3.1",
        "sprain/swiss-qr-bill": "^5.3"
    },
    "suggest": {
        "laravel/pulse": "Kennzahlen auf der Seite «Betrieb» und das Pulse-Dashboard für Betreiber der Installation (B-09)"
    },
    "autoload": {
        "psr-4": {
            "Basalto\\Core\\": "src/",
            "Basalto\\Core\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Basalto\\Core\\CoreServiceProvider"
            ]
        },
        "basalto": {
            "module": "core",
            "name": "Kern",
            "api": 1,
            "switchable": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
