includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - packages/
        - modules/

    excludePaths:
        - packages/*/config/*
        - modules/*/config/*

    level: 7

