APP_NAME=Basalto
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Basalto
BASALTO_BACKEND_PATH=admin
BASALTO_ALIAS_DOMAIN=basaltocms.com
# TB 12 Scheibe 1 (M-21): SaaS-Modus — Registrierung, Konto-Bereich, Testphase; Instanz start (Testphase, Start) oder pro
BASALTO_SAAS=false
BASALTO_INSTANCE=start
BASALTO_SAAS_THEMES=
BASALTO_SAAS_DEFAULT_THEME=starter
# TB 12 Scheibe 4: Umzug zwischen den Instanzen (gemeinsames Geheimnis, mind. 32 Zeichen, auf beiden gleich; Adressen beider)
BASALTO_INSTANCE_SECRET=
BASALTO_INSTANCE_START_URL=
BASALTO_INSTANCE_PRO_URL=
# TB 12 Scheibe 2 (M-21): Abo und Rechnungen der SaaS — Rechnungssteller und Konto (QR-IBAN oder IBAN) für den QR-Zahlteil,
# MwSt.-Satz (0 = nicht pflichtig) und -Nummer, Präfix der Rechnungsnummern (leer = S auf «start», P auf «pro»), Preis-IDs
# der monatlichen Stripe-Preise (CHF); Webhook-Endpunkt https://<host>/stripe/saas-webhook mit STRIPE_WEBHOOK_SECRET
BASALTO_SAAS_CREDITOR="Nguyen Development"
BASALTO_SAAS_CREDITOR_STREET=
BASALTO_SAAS_CREDITOR_BUILDING=
BASALTO_SAAS_CREDITOR_POSTAL_CODE=
BASALTO_SAAS_CREDITOR_CITY=
BASALTO_SAAS_IBAN=
BASALTO_SAAS_BESR_ID=
BASALTO_SAAS_VAT_RATE=0
BASALTO_SAAS_VAT_NUMBER=
BASALTO_SAAS_INVOICE_PREFIX=
BASALTO_SAAS_STRIPE_PRICE_START=
BASALTO_SAAS_STRIPE_PRICE_STANDARD=
BASALTO_SAAS_STRIPE_PRICE_PRO=
BASALTO_SAAS_STRIPE_PRICE_EXTRA_SITE=
BASALTO_SAAS_STRIPE_PRICE_EXTRA_DOMAIN=
# Cloud-Umgebung (ID oder Name), die Kundendomains trägt; LARAVEL_CLOUD_TOKEN als Secret, nie hier
BASALTO_CLOUD_ENVIRONMENT=
# TB 12 Scheibe 3: Domain-Limit der Cloud-Organisation für Kundendomains (Growth 50, Business 250), Warnung ab 80 % unter «Betrieb»
BASALTO_CLOUD_DOMAIN_LIMIT=50
# CR-004 (P-01): Adresse und Kontakt des Herstellers — Lizenz-Links, Hinweise, Marktplatz (lokal: https://basalto.test)
BASALTO_VENDOR_URL=https://basaltocms.com
BASALTO_VENDOR_EMAIL=email@basaltocms.com
# Lizenz (Option 2): Schlüssel von basaltocms.com; ohne Schlüssel gilt Free (1 Benutzer, 1 Site). Offline geprüft (Ed25519).
# Öffentlicher Schlüssel des Produkts: steht im Kern (Core::LICENSE_PUBLIC_KEY); leer lassen — nur für Tests oder eigene Ausstellungen setzen.
BASALTO_LICENSE_PUBLIC_KEY=
BASALTO_LICENSE_KEY=
# Tage «unregistriert», bis das Frontend eine Fussleiste zeigt (D-12)
BASALTO_LICENSE_BANNER_DAYS=30
# TB 11 Scheibe 1 — Lizenzverkauf (nur basaltocms.com): privater Produktschlüssel zum Ausstellen; nie ins Repo, nur als Secret
BASALTO_LICENSE_SECRET_KEY=
# TB 11 Scheibe 2 — Marktplatz: Katalog im Backend jeder Installation; der private Schlüssel nur auf basaltocms.com (Secret, nie ins Repo)
# leer = Adresse des Herstellers (BASALTO_VENDOR_URL)
BASALTO_MARKETPLACE_URL=
BASALTO_MARKETPLACE_SECRET_KEY=
# Ablage der eingereichten Pakete und signierten ZIPs (Flysystem-Disk, nie public — auf Laravel Cloud ein privater Bucket),
# Grösse einer Einreichung in KB und Pfad der Seite mit marketplace.entry (für die Links der JSON-Schnittstelle)
BASALTO_MARKETPLACE_DISK=local
BASALTO_MARKETPLACE_MAX_KB=10240
BASALTO_MARKETPLACE_ENTRY_PATH=/marktplatz-eintrag
# TB 13 Scheibe 1: bezahlter Marktplatz (nur basaltocms.com) — Stripe Connect, zwei Webhooks auf /marketplace/stripe/webhook
BASALTO_MARKETPLACE_PAID=false
BASALTO_MARKETPLACE_STRIPE_WEBHOOK_SECRET=
BASALTO_MARKETPLACE_STRIPE_CONNECT_WEBHOOK_SECRET=
BASALTO_MARKETPLACE_ON_BEHALF_OF=false
# TB 13 Scheibe 1: jede Installation — Zugang zu gekauften Themes (sonst aus auth.json)
BASALTO_MARKETPLACE_EMAIL=
BASALTO_MARKETPLACE_TOKEN=
# Stripe (Modul Lizenzverkauf, Laravel Cashier): Testmodus-Schlüssel aus dem Stripe-Dashboard; ohne sie gibt es nur die QR-Rechnung.
# Webhook-Endpunkt: https://<host>/stripe/webhook — Geheimnis whsec_… von diesem Endpunkt (bzw. von «stripe listen»)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Zeitpunkt der letzten Auslieferung (Cloud-Deploy setzt ihn); erscheint auf der Übersicht unter Betrieb
BASALTO_DEPLOYED_AT=
BASALTO_DEFAULT_SITE=

# Monitoring (B-09, TB 10 Scheibe 6). Pulse zeichnet in der Anwendungsdatenbank auf; Dashboard unter
# /<BASALTO_BACKEND_PATH>/pulse, nur für Besitzer und Verwaltung des Installationskontos. Anleitung: docs/betrieb/monitoring.md
# PULSE_ENABLED=true
# PULSE_PATH=admin/pulse
# PULSE_SLOW_REQUESTS_THRESHOLD=1000
# Nightwatch (Produktion) ist vorbereitet, aber nicht installiert: erst `composer require laravel/nightwatch`, dann
# Token aus nightwatch.laravel.com — auf Laravel Cloud setzt «Connect Nightwatch» diese Werte selbst. Token nie ins Repo.
# NIGHTWATCH_ENABLED=true
# NIGHTWATCH_TOKEN=
# NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1
# NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
# NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0

# TB 11 Scheibe 4 (G-10): öffentliche Demo — Schnellzugang ohne Anmeldung, Mails abgefangen, nächtlich basalto:demo-reset
# (löscht die ganze Datenbank). Nur auf der Demo-Installation auf true setzen, nie sonst.
BASALTO_DEMO=false
